# Kök `.env` — docker compose ve yerel `apps/api` için kopyalayın: cp .env.example .env

POSTGRES_USER=rahatla
POSTGRES_PASSWORD=rahatla_dev
POSTGRES_DB=rahatla
# Mac’te Homebrew Postgres genelde 5432’dedir; Docker ile çakışırsa 5433 kullanın ve aşağıdaki DATABASE_URL portunu eşleştirin.
POSTGRES_PORT=5433
# Host’ta API portu doluysa API_PORT değiştirin.
API_PORT=3000
# Docker içi Prisma Studio (http://localhost:5555)
PRISMA_STUDIO_PORT=5555
JWT_SECRET=rahatla-dev-jwt-secret-change-in-production-min-32

# E-posta (doğrulama / şifre sıfırlama). SMTP_HOST boşsa e-posta gönderilmez; tokenlar API logunda görünür.
# Aynı ayarlar (host, port, from, public URL, AWS yardım linki) /admin-panel/ → «E-posta (SMTP)» üzerinden DB’de saklanabilir; .env üzerine yazar. SMTP_PASS yalnızca ortamda kalır.
# APP_PUBLIC_API_URL: doğrulama bağlantısında kullanılır (örn. https://api.example.com veya http://192.168.1.5:3000).
APP_PUBLIC_API_URL=http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Rahatla <no-reply@localhost>

# Cüzdan: hediye komisyonu (baz puan = 10 000 → 1000 = %10). price_minor katalog birimi (ör. kuruş veya jeton).
WALLET_GIFT_FEE_BPS=1000
# Çekim talebi için minimum tutar (aynı birim).
WALLET_MIN_PAYOUT_MINOR=10000

# Yerel makineden (API host’ta) Postgres konteynırına bağlanırken:
DATABASE_URL=postgresql://rahatla:rahatla_dev@localhost:5433/rahatla

# S3 / object storage (profil fotoğrafı, sohbet görseli, doğrulama selfie)
# MinIO/Cloudflare R2/AWS S3 uyumlu endpoint kullanılabilir.
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Opsiyonel: public CDN/base URL (varsa doğrudan bunu döndürür)
S3_PUBLIC_BASE_URL=

# Firebase Admin (test push / FCM). İkisinden biri (öncelik: JSON > dosya yolu):
# 1) JSON icerigi (plain veya base64)
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2) Service account JSON dosyası. Proje köküne `rahatla-secret.json` koyup git’e eklemeyin (.gitignore’da).
#    API’yi host’ta çalıştırırken (docker değil): proje kökünden göreli yol yeterli.
#    Docker: compose bu dosyayı /app/rahatla-secret.json olarak mount eder; ekstra ayar gerekmez.
FIREBASE_SERVICE_ACCOUNT_PATH=./rahatla-secret.json
